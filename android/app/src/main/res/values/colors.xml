<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================ -->
    <!-- Organic Modern palette - LIGHT                                -->
    <!-- Dark-mode overrides live in values-night/colors.xml.          -->
    <!-- Token names are kept stable because code references them;    -->
    <!-- the comment on each line describes its actual role.           -->
    <!-- ============================================================ -->

    <!-- Surfaces -->
    <color name="us_bg">#F5F6F2</color>               <!-- soft off-white page -->
    <color name="us_surface">#FFFFFF</color>
    <color name="us_surface_card">#FFFFFF</color>
    <color name="us_surface_raised">#EDF0EA</color>   <!-- light grey-green tint -->
    <color name="us_surface_input">#F3F5F0</color>
    <color name="us_scrim">#66141A16</color>

    <!-- Outlines -->
    <color name="us_outline">#E2E6DF</color>
    <color name="us_outline_strong">#C4CBC1</color>
    <!-- Formerly neon edges; now plain hairlines -->
    <color name="us_outline_glow">@color/us_outline</color>
    <color name="us_outline_glow_aqua">@color/us_outline</color>

    <!-- Text -->
    <color name="us_text_primary">#1E2621</color>
    <color name="us_text_secondary">#58625C</color>
    <color name="us_text_hint">#89928C</color>
    <color name="us_text_disabled">#B3B9B4</color>

    <!-- Primary: Deep Forest Green -->
    <color name="us_bio_green">#2F6B3A</color>
    <color name="us_bio_green_dim">#24542D</color>
    <color name="us_bio_green_container">#DDEBDD</color>
    <color name="us_bio_green_glow">#1F2F6B3A</color>
    <color name="us_on_bio_green">#FFFFFF</color>
    <color name="us_on_bio_green_container">#163A1E</color>

    <!-- Secondary: calm Water Blue (irrigation) -->
    <color name="us_aqua">#2D7398</color>
    <color name="us_aqua_dim">#245C7A</color>
    <color name="us_aqua_container">#DCEBF3</color>
    <color name="us_on_aqua">#FFFFFF</color>
    <color name="us_on_aqua_container">#123547</color>

    <!-- Tertiary: Ochre / clay (warnings, humidity) -->
    <color name="us_amber">#B8742A</color>
    <color name="us_amber_container">#F6E8D6</color>

    <!-- Error: soft Terracotta -->
    <color name="us_danger">#B34A3C</color>
    <color name="us_danger_container">#F8E1DC</color>
    <color name="us_on_danger">#FFFFFF</color>

    <!-- Harvest gold (sunlight) -->
    <color name="us_violet">#B88A17</color>
    <color name="us_sun_container">#F6EECF</color>

    <!-- Sage (soft accent: nav indicator, chips) -->
    <color name="us_sage">#DCE6D6</color>

    <!-- Hero / photo placeholder fills -->
    <color name="us_hero_start">#E4EFE3</color>
    <color name="us_hero_end">#DCEAF0</color>

    <!-- Gauge zone tints (CircularGaugeView) -->
    <color name="gauge_green_faint">#D6E6D6</color>
    <color name="gauge_orange_faint">#F1E0C8</color>
    <color name="gauge_red_faint">#F2D3CD</color>

    <!-- ============================================================ -->
    <!-- Legacy names (kept so existing references still resolve)      -->
    <!-- ============================================================ -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="primary">@color/us_bio_green</color>

    <color name="gauge_green">@color/us_bio_green</color>
    <color name="gauge_orange">@color/us_amber</color>
    <color name="gauge_red">@color/us_danger</color>
