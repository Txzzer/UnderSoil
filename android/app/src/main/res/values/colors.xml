    <color name="border_grey">@color/us_outline</color>
    <color name="card_grey">@color/us_surface_input</color>
    <color name="sensor_activate_teal">@color/us_aqua</color>
    <color name="water_color">@color/us_aqua</color>
    <color name="sunlight_color">@color/us_violet</color>
    <color name="fertilizer_color">@color/us_danger</color>
    <color name="humidity_color">@color/us_amber</color>
</resources>
