<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="112dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp">

            <!-- Top Navigation Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_white"
                    android:contentDescription="Back"
                    android:padding="12dp"
                    android:src="@drawable/ic_back_arrow"
                    app:tint="@color/us_text_primary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Control centre"
                        android:textAppearance="@style/TextAppearance.AgriTech.Label"
                        android:textColor="@color/us_aqua" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IoT Dashboard"
                        android:textAppearance="@style/TextAppearance.AgriTech.Headline" />
                </LinearLayout>
            </LinearLayout>

            <!-- Leak / Unintended Flow Warning Banner Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWarningBanner"
                style="@style/Widget.AgriTech.CardView.Alert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/us_danger_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        style="@style/Widget.AgriTech.IconTile.Danger"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_flow_rate" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            android:text="UNINTENDED FLOW DETECTED!"
                            android:textColor="@color/us_danger"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvWarningBannerText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Active flow detected while valve is CLOSED."
                            android:textColor="@color/us_text_primary"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWarningAction"
                        style="@style/Widget.AgriTech.Button.Text.Danger"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OPEN VALVE" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Top Header Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AgriTech.CardView.Aqua"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDeviceTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="UnderSoil Telemetry"
                            android:textAppearance="@style/TextAppearance.AgriTech.Title"
                            android:textSize="19sp" />

                        <TextView
                            android:id="@+id/tvStreamStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_badge"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="● Live (3s)"
                            android:textColor="@color/valve_open"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDeviceId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:drawableStart="@drawable/ic_sector_node"
                        android:drawablePadding="8dp"
                        android:drawableTint="@color/us_aqua"
                        android:fontFamily="monospace"
                        android:gravity="center_vertical"
                        android:text="Device ID: Connecting..."
                        android:textColor="@color/us_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvLastUpdated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:text="Last update: Never"
                        android:textColor="@color/us_text_hint"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Temperature & Humidity Gauges Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Temperature Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <ImageView
                            style="@style/Widget.AgriTech.IconTile.Amber"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:padding="7dp"
                            android:src="@drawable/ic_thermometer" />

                        <com.example.undersoil.CircularGaugeView
                            android:id="@+id/gaugeTemperature"
                            android:layout_width="140dp"
                            android:layout_height="140dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="16dp" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Humidity Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <ImageView
                            style="@style/Widget.AgriTech.IconTile.Aqua"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:padding="7dp"
                            android:src="@drawable/ic_humidity" />

                        <com.example.undersoil.CircularGaugeView
                            android:id="@+id/gaugeHumidity"
                            android:layout_width="140dp"
                            android:layout_height="140dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="16dp" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Flow Rate Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AgriTech.CardView.Aqua"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        style="@style/Widget.AgriTech.IconTile.Aqua"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:padding="11dp"
                        android:src="@drawable/ic_flow_rate" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FLOW RATE"
                            android:textAppearance="@style/TextAppearance.AgriTech.Label" />

                        <TextView
                            android:id="@+id/tvFlowRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0.0 L/min"
                            android:textAppearance="@style/TextAppearance.AgriTech.DataValue"
                            android:textColor="@color/flow_rate_blue" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFlowStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_badge"
                        android:backgroundTint="@color/us_surface_raised"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="No Flow"
                        android:textColor="@color/us_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Actuator / Valve Control Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardValveControl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTUATOR CONTROL"
                        android:textAppearance="@style/TextAppearance.AgriTech.Label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Valve "node": glowing halo pulses while the valve is ON -->
                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <View
                                android:id="@+id/viewValveGlow"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_valve_node_glow"
                                android:visibility="invisible" />

                            <View
                                android:id="@+id/viewValveCore"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_valve_node_core"
                                android:backgroundTint="@color/valve_closed" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvValveStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-condensed"
                            android:letterSpacing="0.04"
                            android:text="Valve: CLOSED"
                            android:textColor="@color/valve_closed"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleValve"
                            style="@style/Widget.AgriTech.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Turn Valve ON" />

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScheduleWatering"
                        style="@style/Widget.AgriTech.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Schedule Watering"
                        app:icon="@drawable/ic_drop"
                        app:iconGravity="textStart" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recent valve actions (hidden unless the history call succeeds) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardValveHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RECENT VALVE ACTIONS"
                        android:textAppearance="@style/TextAppearance.AgriTech.Label" />

                    <!-- Rows are added by IotScreenActivity (latest 5 actions) -->
                    <LinearLayout
                        android:id="@+id/llValveHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Curved Bottom App Bar with cradle -->
    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:menu="@menu/bottom_nav_menu" />

    </com.google.android.material.bottomappbar.BottomAppBar>

    <!-- Center Floating Action Button (FAB) for Home -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/nav_home"
        android:src="@drawable/ic_home"
        app:layout_anchor="@id/bottomAppBar"
        app:maxImageSize="28dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
