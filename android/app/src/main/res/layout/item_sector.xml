<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.AgriTech.CardView.Aqua"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            style="@style/Widget.AgriTech.IconTile.Aqua"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Sector Icon"
            android:importantForAccessibility="yes"
            android:padding="11dp"
            android:src="@drawable/ic_iot_valve" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSectorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sector A"
                android:textAppearance="@style/TextAppearance.AgriTech.Title"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvSectorCrops"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Crops: Tomatoes, Potatoes"
                android:textColor="@color/us_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Open Sector"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/us_aqua" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
