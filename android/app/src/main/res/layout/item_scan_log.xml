<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivLogIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_photo_placeholder"
            android:contentDescription="Scanned plant photo"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_leaf_scan"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.AgriTech.Small"
            app:strokeColor="@color/us_outline"
            app:strokeWidth="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLogDiagnosis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Healthy"
                android:textAppearance="@style/TextAppearance.AgriTech.Title"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvLogConfidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawableStart="@drawable/ic_confidence"
                android:drawablePadding="6dp"
                android:drawableTint="@color/us_aqua"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center_vertical"
                android:text="98.5% Confidence"
                android:textColor="@color/us_aqua"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLogDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="2026-09-24"
            android:textColor="@color/us_text_hint"
            android:textSize="11sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
