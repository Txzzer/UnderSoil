<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    android:background="@color/white"
    android:elevation="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="40dp">

        <ImageButton
            android:id="@+id/navValveButton"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_valve"
            android:contentDescription="Valve control" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1.4" />

        <ImageButton
            android:id="@+id/navTreeButton"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_tree"
            android:contentDescription="My fields" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/navHomeButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_circle_green"
        android:elevation="8dp"
        android:padding="14dp"
        android:src="@drawable/ic_home"
        android:contentDescription="Home" />

</FrameLayout>