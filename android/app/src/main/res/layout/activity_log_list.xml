<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:padding="20dp">

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_circle_white"
        android:contentDescription="Back"
        android:padding="12dp"
        android:src="@drawable/ic_back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/us_text_primary" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Crop Logs"
        android:textAppearance="@style/TextAppearance.AgriTech.Headline"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@id/backButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/backButton"
        app:layout_constraintTop_toTopOf="@id/backButton" />

    <TextView
        android:id="@+id/tvLogHeader"
        style="@style/Widget.AgriTech.SectionHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Scan History"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/backButton" />

    <FrameLayout
        android:id="@+id/recyclerContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/diagnosisButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLogHeader">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvScanLogs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_slide_up"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_scan_log" />

        <TextView
            android:id="@+id/tvEmptyLogs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawableTop="@drawable/ic_leaf_scan"
            android:drawablePadding="14dp"
            android:drawableTint="@color/us_text_hint"
            android:lineSpacingExtra="4dp"
            android:text="No scan logs yet for this crop.\nTap 'Scan Plant' to run a diagnosis."
            android:textAlignment="center"
            android:textAppearance="@style/TextAppearance.AgriTech.Body"
            android:visibility="gone" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/diagnosisButton"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_circle_green"
        android:contentDescription="Start diagnosis"
        android:elevation="4dp"
        android:scaleType="center"
        android:src="@drawable/ic_camera"
        app:layout_constraintBottom_toTopOf="@id/diagnosisLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/us_on_bio_green" />

    <TextView
        android:id="@+id/diagnosisLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Scan Plant"
        android:textAppearance="@style/TextAppearance.AgriTech.Label"
        android:textColor="@color/us_bio_green"
        app:layout_constraintBottom_toTopOf="@id/viewInfoButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/viewInfoButton"
        style="@style/Widget.AgriTech.Button.Outlined"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:text="View Plant Information"
        app:icon="@drawable/ic_info_circle"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
